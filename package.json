{
  "name": "donote",
  "version": "0.4.3",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev:web": "pnpm --filter @donote/web dev",
    "build:web": "pnpm --filter @donote/web build",
    "dev:desktop": "pnpm --filter @donote/desktop dev",
    "build:desktop": "pnpm --filter @donote/desktop build",
    "typecheck": "pnpm -r typecheck",
    "regress": "node scripts/regression/run-regression.cjs",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
