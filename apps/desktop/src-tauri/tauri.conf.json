{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DoNote",
  "version": "0.4.4",
  "identifier": "com.donote.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter @donote/web dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm --filter @donote/web build",
    "frontendDist": "../../web/dist"
  },
  "app": {
  "windows": [
    {
      "label": "main",
      "title": "DoNote",
      "width": 1120,
      "height": 780,
      "minWidth": 880,
      "minHeight": 600,
      "center": true,
      "useHttpsScheme": true,
      "decorations": false,
      "create": false
    }
  ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "shortDescription": "本地优先的 Markdown 笔记",
    "longDescription": "DoNote 把笔记以 .md 文件存在你自己的 WebDAV 网盘里，不走任何第三方服务器。",
    "copyright": "Copyright © 2026 peidongl98, MIT License",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": [
          "SimpChinese"
        ],
        "installerHooks": "./windows/installer-hooks.nsi"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://donote.pages.dev/updates/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyRkM1NzYyRDlBRUUwNTgKUldSWTRLN1pZbGY4NHVZdVdxYWI0UGVMdHVSSG9ETTZBSXZ5V0pZdUVtZlJBdHdpa0pJUncxMmsK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
