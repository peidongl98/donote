{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "DoNote 的通用权限：放行用户自行填写的 WebDAV 服务器（http/https，任意主机与端口）、插入图片时的系统文件对话框，以及无边框窗口自绘标题栏所需的窗口操作。必须写明 windows —— Tauri 运行时只放行 windows / webviews 里命中当前窗口的命令（见 tauri::ipc::authority::resolve_access），不写等于一条也不放行。桌面端与安卓壳的窗口 label 都是 main",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*:*" }, { "url": "http://*:*" }]
    },
    "process:default",
    "dialog:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }]
    },
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close"
  ]
}
