{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "DoNote 桌面端权限：放行用户自行填写的 WebDAV 服务器（http/https，任意主机与端口），以及插入图片时的系统文件对话框",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*:*" }, { "url": "http://*:*" }]
    },
    "updater:default",
    "process:default",
    "dialog:default"
  ]
}
