# dependencies
node_modules/
.pnpm-store/

# build output
dist/
dist-ssr/
# 构建时把 dist 让开而生成的副本（dist.before-cache / dist.keep / dist.building …），
# 与 dist/ 同类：都是可再生成的产物，不该出现在 git status 里
dist.*/
*.local

# cloudflare
.wrangler/
.dev.vars
.dev.vars.*

# env & secrets（.env.production 只放非敏感构建常量，需要入库）
.env
.env.*
!.env.example
!.env.production

# editor / os
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# logs
*.log
npm-debug.log*
pnpm-debug.log*

# 回归脚手架：本机配置（含账号 / 密钥文件路径）与产物
scripts/regression/local.json
scripts/regression/.artifacts/
scripts/regression/.logs/

# scratch
.workbuddy/tmp/

# 更新签名私钥：只在本机保存，绝不入库
.updater-key/

# 安装包是可再生成的产物（每次发版都变、体积 MB 级），由 scripts/make-release.mjs 铺出来
site/downloads/*
